# ── Server ────────────────────────────────────────────────
PORT=3000

# ── SAP B1 Service Layer ──────────────────────────────────
SAP_HOST=192.168.1.100          # IP or hostname of your B1 server
SAP_USER=manager
SAP_PASSWORD=your-b1-password
SAP_COMPANY=SBODemoUS
SAP_WEBHOOK_SECRET=your-hmac-secret   # you define this, paste same value when registering

# ── Odoo ─────────────────────────────────────────────────
ODOO_BASE_URL=https://your-odoo-instance.com
ODOO_API_KEY=your-odoo-api-key        # matches OdooApi:ApiKey in .NET appsettings.json
