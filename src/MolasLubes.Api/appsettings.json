{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MolasCacheDb": "Server=.;Database=MolasCacheDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ApiSecurity": {
    "ApiKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS"
  },
  "OdooApi": {
    "BaseUrl": "https://mlaseko-molas-lubes.odoo.com",
    "ApiKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS"
  },
  "SyncSettings": {
    "EnableInvoiceCacheSync": true,
    "EnablePaymentCacheSync": true,
    "EnableNeonInvoiceSync": true,
    "EnableNeonPaymentSync": true,
    "EnableNeonCustomerSync": true,
    "EnableOdooDeliveryPush": false,
    "EnableOdooInvoicePush": false,
    "EnableOdooPaymentPush": false
  },
  "LiquiMolyScraper": {
    "BaseUrl": "https://www.liqui-moly.com",
    "OwwApiPrefix": "",
    "DelayBetweenRequestsMs": 1500,
    "DelayBetweenCategoriesMs": 3000,
    "RequestTimeoutSeconds": 30,
    "BatchSize": 50,
    "MaxConcurrency": 1,
    "MaxParallelRequests": 6
  },
  "AllowedHosts": "*"
}