# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:5050

# API key sent in X-Api-Key header on every request
NEXT_PUBLIC_API_KEY=your-api-key-here

# Secret used to sign/verify the claims cookie (server-side only)
# Generate with: openssl rand -hex 32
JWT_COOKIE_SECRET=replace-with-32-byte-hex-secret

# Cookie name for the httpOnly JWT
MOLAS_TOKEN_COOKIE=molas_token

# Cookie name for non-sensitive user claims (readable by client JS)
MOLAS_CLAIMS_COOKIE=molas_claims
